{
  "name": "pop-console-plugin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "webpack --config webpack.config.js --mode=production",
    "dev": "webpack serve --mode=development",
    "lint": "eslint src/",
    "test": "jest"
  },
  "consolePlugin": {
    "name": "pop-console-plugin",
    "version": "0.1.0",
    "displayName": "POP - Power Outage Provisioner",
    "description": "Manage etcd backups and cluster lifecycle operations",
    "exposedModules": {
      "DashboardPage": "./components/DashboardPage",
      "BackupPage": "./components/BackupPage",
      "ShutdownPage": "./components/ShutdownPage",
      "AutomatedProceduresPage": "./components/AutomatedProceduresPage",
      "SettingsPage": "./components/SettingsPage",
      "EtcdBackupList": "./components/EtcdBackupList",
      "ClusterShutdownList": "./components/ClusterShutdownList",
      "ClusterRestartList": "./components/ClusterRestartList",
      "BackupScheduleList": "./components/BackupScheduleList"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  },
  "dependencies": {
    "@openshift-console/dynamic-plugin-sdk": "1.6.0",
    "@patternfly/react-core": "^5.0.0",
    "@patternfly/react-icons": "^5.0.0",
    "@patternfly/react-table": "^5.0.0",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-router-dom": "5.3.4"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk-webpack": "1.2.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "css-loader": "^6.8.0",
    "eslint": "^10.3.0",
    "jest": "^30.4.2",
    "style-loader": "^3.3.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.4.0",
    "typescript": "^5.0.0",
    "webpack": "5.75.0",
    "webpack-cli": "5.0.1",
    "webpack-dev-server": "4.11.1"
  }
}
