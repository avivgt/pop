{
  "name": "pop-console-plugin",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "build": "webpack --config webpack.config.js --mode=production",
    "dev": "webpack serve --mode=development",
    "lint": "eslint src/",
    "test": "jest"
  },
  "consolePlugin": {
    "name": "pop-console-plugin",
    "version": "0.2.1",
    "displayName": "POP - Power Outage Provisioner",
    "description": "Manage etcd backups and cluster lifecycle operations",
    "exposedModules": {
      "DashboardPage": "./components/DashboardPage",
      "BackupPage": "./components/BackupPage",
      "ShutdownPage": "./components/ShutdownPage",
      "AutomatedProceduresPage": "./components/AutomatedProceduresPage",
      "SettingsPage": "./components/SettingsPage",
      "EtcdBackupList": "./components/EtcdBackupList",
      "ClusterShutdownList": "./components/ClusterShutdownList",
      "ClusterRestartList": "./components/ClusterRestartList",
      "BackupScheduleList": "./components/BackupScheduleList",
      "FleetDashboardPage": "./components/FleetDashboardPage",
      "FleetShutdownList": "./components/FleetShutdownList",
      "FleetShutdownCreate": "./components/FleetShutdownCreate",
      "FleetBootSequenceList": "./components/FleetBootSequenceList"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  },
  "dependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.22.0",
    "@patternfly/react-core": "~6.4.2",
    "@patternfly/react-icons": "~6.4.0",
    "@patternfly/react-table": "~6.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.22.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "css-loader": "^6.8.0",
    "eslint": "^10.3.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "style-loader": "^3.3.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.4.0",
    "typescript": "^5.0.0",
    "webpack": "^5.100.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  }
}
