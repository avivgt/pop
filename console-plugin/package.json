{
  "name": "pop-console-plugin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "webpack --mode=production",
    "dev": "webpack serve --mode=development",
    "lint": "eslint src/"
  },
  "consolePlugin": {
    "name": "pop-console-plugin",
    "version": "0.1.0",
    "displayName": "POP - Platform Outage Provisioner",
    "description": "Manage etcd backups and cluster lifecycle operations",
    "exposedModules": {
      "DashboardPage": "./components/DashboardPage",
      "EtcdBackupList": "./components/EtcdBackupList",
      "ClusterShutdownList": "./components/ClusterShutdownList",
      "BackupScheduleList": "./components/BackupScheduleList",
      "ClusterRestartList": "./components/ClusterRestartList"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  },
  "dependencies": {
    "@openshift-console/dynamic-plugin-sdk": "1.6.0",
    "@patternfly/react-core": "^5.0.0",
    "@patternfly/react-icons": "^5.0.0",
    "@patternfly/react-table": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk-webpack": "1.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "css-loader": "^6.8.0",
    "style-loader": "^3.3.0",
    "ts-loader": "^9.4.0",
    "typescript": "^5.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  }
}
